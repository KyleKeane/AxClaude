<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AxClaude</RootNamespace>
    <AssemblyName>AxClaude</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>AxClaude.ico</ApplicationIcon>
    <Version>1.0.2</Version>
    <Product>AxClaude</Product>
    <Description>Accessible front end for the Claude Code CLI in screen reader mode</Description>
    <Authors>Dr. Kyle Keane</Authors>
    <Company>Dr. Kyle Keane, www.kylekeane.com</Company>
    <Copyright>Copyright (c) 2026 Dr. Kyle Keane (www.kylekeane.com). MIT License.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxClaude.Core\AxClaude.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help, User guide shows this file; publish.ps1 ships it next to the executable as README.md. -->
    <EmbeddedResource Include="..\..\docs\user-guide.md" LogicalName="UserGuide.md" />
  </ItemGroup>

</Project>
